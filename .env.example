# =============================================================================
# Buukuu Environment Configuration
# =============================================================================
# Copy this file to '.env' to override any defaults.
# All settings below are shown commented out with their default values.
# =============================================================================

# --- Security & Authentication ---
# SECRET_KEY=buukuu-secret-key-change-in-production
# BUUKUU_AUTH_REQUIRED=true
# BUUKUU_ALLOW_REGISTRATION=true

# --- Server & Network ---
# PORT=5000
# APP_ENV=development
# DEBUG=false
# LOG_LEVEL=INFO

# --- Database ---
# DATABASE_URL=sqlite:///data/buukuu.db

# --- Storage Paths ---
# BUUKUU_DATA_DIR=data
# BUUKUU_LIBRARY_DIR=data/books
#
# Multiple library directories can be configured in any of the following ways:
# 1. Numbered variables (BUUKUU_LIBRARY_DIR1, BUUKUU_LIBRARY_DIR2, BUUKUU_LIBRARY_DIR3, ... or BUUKUU_LIBRARY_DIR_1, ...):
# BUUKUU_LIBRARY_DIR1=/mnt/nas/ebooks
# BUUKUU_LIBRARY_DIR2=/media/manga
# BUUKUU_LIBRARY_DIR3=/home/user/calibre
#
# 2. Delimited list in BUUKUU_LIBRARY_DIR (separated by :, ;, or ,):
# BUUKUU_LIBRARY_DIR=/mnt/nas/books:/media/manga:data/books
#
# 3. Named category variables (e.g. BUUKUU_LIBRARY_DIR_MANGA, BUUKUU_LIBRARY_DIR_COMICS):
# BUUKUU_LIBRARY_DIR_MANGA=/media/manga
# BUUKUU_LIBRARY_DIR_COMICS=/media/comics
#
# BUUKUU_COVERS_DIR=data/covers
# BUUKUU_OPTIMIZED_DIR=data/optimized

# --- Library Scanner & Watcher ---
# BUUKUU_AUTO_SCAN=true
# BUUKUU_WATCH_LIBRARY=true

# --- Metadata Enrichment ---
# BUUKUU_AUTO_ENRICH=false
# BUUKUU_METADATA_PROVIDER=all

# --- UI & Pagination ---
# BUUKUU_PAGE_SIZE=24
