# Application Configuration Example
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# Security
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Server settings
PORT=5000
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Storage paths
BUUKUU_DATA_DIR=data
# BUUKUU_LIBRARY_DIR=data/books
# BUUKUU_COVERS_DIR=data/covers

# Application behavior
BUUKUU_AUTH_REQUIRED=true
BUUKUU_ALLOW_REGISTRATION=true
BUUKUU_AUTO_SCAN=true
BUUKUU_WATCH_LIBRARY=true
BUUKUU_AUTO_ENRICH=false
BUUKUU_METADATA_PROVIDER=all
BUUKUU_PAGE_SIZE=24
