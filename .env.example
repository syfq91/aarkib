# =============================================================================
# Aarkib Environment Configuration
# =============================================================================
# Copy this file to '.env' to override any defaults.
# All settings below are shown commented out with their default values.
# =============================================================================

# --- Security & Authentication ---
# Optional: Secret key for session security. If omitted, Aarkib automatically generates
# a secure 64-character hex key and persists it to '<DATA_DIR>/secret_key' on first boot.
# You can also generate one manually with: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=
# AARKIB_AUTH_REQUIRED=true
# AARKIB_ALLOW_REGISTRATION=true

# --- Server & Network ---
# PORT=5000
# APP_ENV=development
# FLASK_DEBUG=false
# LOG_LEVEL=INFO

# --- Database ---
# DATABASE_URL=sqlite:///data/aarkib.db

# --- Storage Paths ---
# AARKIB_DATA_DIR=data
# AARKIB_LIBRARY_DIR=data/books
#
# Multiple library directories can be configured in any of the following ways:
# 1. Numbered variables (AARKIB_LIBRARY_DIR1, AARKIB_LIBRARY_DIR2, AARKIB_LIBRARY_DIR3, ... or AARKIB_LIBRARY_DIR_1, ...):
# AARKIB_LIBRARY_DIR1=/mnt/nas/ebooks
# AARKIB_LIBRARY_DIR2=/media/manga
# AARKIB_LIBRARY_DIR3=/home/user/calibre
#
# 2. Delimited list in AARKIB_LIBRARY_DIR (separated by :, ;, or ,):
# AARKIB_LIBRARY_DIR=/mnt/nas/books:/media/manga:data/books
#
# 3. Named category variables (e.g. AARKIB_LIBRARY_DIR_MANGA, AARKIB_LIBRARY_DIR_COMICS, AARKIB_LIBRARY_DIR_AUDIO, AARKIB_LIBRARY_DIR_VIDEO):
# AARKIB_LIBRARY_DIR_MANGA=/media/manga
# AARKIB_LIBRARY_DIR_COMICS=/media/comics
# AARKIB_LIBRARY_DIR_AUDIO=/media/audio
# AARKIB_LIBRARY_DIR_VIDEO=/media/video
#
# Legacy BUUKUU_* variables are also supported for backward compatibility.
#
# AARKIB_COVERS_DIR=data/covers
# AARKIB_OPTIMIZED_DIR=data/optimized

# --- Library Scanner & Watcher ---
# AARKIB_AUTO_SCAN=true
# AARKIB_WATCH_LIBRARY=true

# --- Metadata Enrichment ---
# AARKIB_AUTO_ENRICH=false
# AARKIB_METADATA_PROVIDER=all

# --- UI & Pagination ---
# AARKIB_PAGE_SIZE=24
