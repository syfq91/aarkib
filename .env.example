# =============================================================================
# Aarkib Environment Configuration
# =============================================================================
# Copy this file to '.env' to override any defaults.
# All settings below are shown commented out with their default values.
# Note: Application preferences (auto-scan on startup, folder watcher,
# auto-enrich, metadata provider, page size) are managed exclusively via the
# WebUI (Settings -> System Preferences) and persisted in the database.
# =============================================================================

# --- Security & Authentication ---
# Optional: Secret key for session security. If omitted, Aarkib automatically generates
# a secure 64-character hex key and persists it to '<DATA_DIR>/secret_key' on first boot.
# You can also generate one manually with: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=
# Authentication is always required. On first boot (0 users), visit http://localhost:5000
# to create the primary administrator account (with or without a password).

# --- Server & Network ---
# PORT=5000
# APP_ENV=development
# FLASK_DEBUG=false
# LOG_LEVEL=INFO

# --- Database ---
# DATABASE_URL=sqlite:///data/aarkib.db

# --- Storage Paths ---
# AARKIB_DATA_DIR=data
# AARKIB_MEDIA_DIR=data/media
# Primary media directory. Additional media folders and their content types (books, comics,
# movies/shows, audio, music, etc.) can be browsed, added, and configured directly
# in the WebUI (Settings -> Media Folders & Libraries).
# Optional baseline container mounts can also be declared using numbered variables:
# AARKIB_MEDIA_DIR1=/mnt/nas/ebooks
# AARKIB_MEDIA_DIR2=/media/manga
# AARKIB_MEDIA_DIR3=/home/user/calibre
#
# AARKIB_COVERS_DIR=data/covers
# AARKIB_OPTIMIZED_DIR=data/optimized
