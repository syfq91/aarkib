# =============================================================================
# Buukuu Environment Configuration Example
# =============================================================================
# Copy this file to '.env' and adjust the values as needed.
# All settings below are shown commented out with their default values.
# DO NOT commit your actual '.env' file to version control.
# =============================================================================

# =============================================================================
# Security & Authentication
# =============================================================================
# Secret key used for signing session cookies and cryptographic operations.
# Must be set to a strong random string in production!
# SECRET_KEY=buukuu-secret-key-change-in-production
# BUUKUU_SECRET_KEY=buukuu-secret-key-change-in-production

# Require users to log in before browsing the library or accessing OPDS feeds
# BUUKUU_AUTH_REQUIRED=true

# Allow new users to register an account from the web UI
# BUUKUU_ALLOW_REGISTRATION=true

# =============================================================================
# Server & Network Settings
# =============================================================================
# Port on which the Buukuu web server listens
# PORT=5000

# Application environment (development | production | testing)
# APP_ENV=development

# Enable or disable Flask debug mode
# DEBUG=false

# Logging verbosity level (DEBUG | INFO | WARNING | ERROR | CRITICAL)
# LOG_LEVEL=INFO

# =============================================================================
# Database Configuration
# =============================================================================
# SQLAlchemy database connection URI (defaults to SQLite in data directory)
# DATABASE_URL=sqlite:///data/buukuu.db
# BUUKUU_DATABASE_URI=sqlite:///data/buukuu.db

# =============================================================================
# Storage & Directory Paths
# =============================================================================
# Base data directory where database, covers, and default library are stored
# BUUKUU_DATA_DIR=data

# Directory containing books and comics (.epub, .cbz, .cbr)
# BUUKUU_LIBRARY_DIR=data/books
# BUUKUU_BOOKS_DIR=data/books

# Directory where generated cover thumbnail images are cached (.webp)
# BUUKUU_COVERS_DIR=data/covers

# =============================================================================
# Library Scanner & Watcher
# =============================================================================
# Automatically scan the library directory for new/updated books on server startup
# BUUKUU_AUTO_SCAN=true

# Watch library folder in background for real-time filesystem changes
# BUUKUU_WATCH_LIBRARY=true

# =============================================================================
# Metadata & Online Enrichment
# =============================================================================
# Automatically fetch online metadata (covers, synopsis, tags) during scans
# BUUKUU_AUTO_ENRICH=false

# Metadata provider to use for online lookups (all | googlebooks | openlibrary)
# BUUKUU_METADATA_PROVIDER=all

# =============================================================================
# User Interface & Pagination
# =============================================================================
# Number of books displayed per page in library, author, series, and tag views
# BUUKUU_PAGE_SIZE=24
