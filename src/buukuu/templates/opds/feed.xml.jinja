<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom"
      xmlns:opds="http://opds-spec.org/2010/catalog"
      xmlns:dc="http://purl.org/dc/elements/1.1/">
  <id>{{ feed_id }}</id>
  <title>{{ feed_title }}{% if preset %} ({{ preset|upper }} Optimized){% endif %}</title>
  {% if feed_subtitle %}<subtitle>{{ feed_subtitle }}</subtitle>{% endif %}
  <updated>{{ now_iso }}</updated>
  <link rel="self" type="application/atom+xml;profile=opds-catalog;kind=acquisition" href="{{ self_url }}"/>
  <link rel="start" type="application/atom+xml;profile=opds-catalog;kind=navigation" href="{{ base_url }}{{ opds_prefix }}"/>
  <link rel="search" type="application/opensearchdescription+xml" href="{{ base_url }}{{ opds_prefix }}/search/opensearch.xml"/>

  {% if pagination and pagination.has_prev %}
  <link rel="previous" type="application/atom+xml;profile=opds-catalog;kind=acquisition" href="{{ base_url }}{{ opds_prefix }}/recent?page={{ pagination.prev_num }}"/>
  {% endif %}
  {% if pagination and pagination.has_next %}
  <link rel="next" type="application/atom+xml;profile=opds-catalog;kind=acquisition" href="{{ base_url }}{{ opds_prefix }}/recent?page={{ pagination.next_num }}"/>
  {% endif %}

  {% for book in books %}
  <entry>
    <title>{{ book.title }}</title>
    <id>urn:buukuu:book:{{ book.id }}{% if preset %}:{{ preset }}{% endif %}</id>
    <updated>{{ book.updated_at.isoformat() if book.updated_at else now_iso }}</updated>
    {% for author in book.authors %}
    <author>
      <name>{{ author.name }}</name>
    </author>
    {% endfor %}
    {% if not book.authors %}
    <author><name>Unknown Author</name></author>
    {% endif %}

    {% if book.description %}
    <summary type="text">{{ book.description }}</summary>
    {% endif %}

    {% for tag in book.tags %}
    <category term="{{ tag.name }}" label="{{ tag.name }}"/>
    {% endfor %}

    {% if book.language %}
    <dc:language>{{ book.language }}</dc:language>
    {% endif %}
    {% if book.publisher %}
    <dc:publisher>{{ book.publisher }}</dc:publisher>
    {% endif %}
    {% if book.isbn %}
    <dc:identifier>urn:isbn:{{ book.isbn }}</dc:identifier>
    {% endif %}

    <!-- Cover Images -->
    <link rel="http://opds-spec.org/image" type="image/webp" href="{{ base_url }}/api/books/{{ book.id }}/cover"/>
    <link rel="http://opds-spec.org/image/thumbnail" type="image/webp" href="{{ base_url }}/api/books/{{ book.id }}/cover"/>

    <!-- Acquisition Download -->
    {% if book.file_format == 'epub' %}
      {% if preset %}
      <link rel="http://opds-spec.org/acquisition" type="application/epub+zip" href="{{ base_url }}/api/books/{{ book.id }}/download/optimized/{{ preset }}" length="{{ book.file_size }}"/>
      {% else %}
      <link rel="http://opds-spec.org/acquisition" type="application/epub+zip" href="{{ base_url }}/api/books/{{ book.id }}/download" length="{{ book.file_size }}"/>
      {% endif %}
    {% else %}
    <link rel="http://opds-spec.org/acquisition" type="application/vnd.comicbook+zip" href="{{ base_url }}/api/books/{{ book.id }}/download" length="{{ book.file_size }}"/>
    {% endif %}

    <!-- OPDS Progression 1.0 Sync Service -->
    <link rel="http://opds-spec.org/progression" type="application/opds-progression+json" href="{{ base_url }}/opds/books/{{ book.id }}/progression"/>
  </entry>
  {% endfor %}
</feed>
